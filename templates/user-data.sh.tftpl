#!/bin/bash
set -euo pipefail
dnf install -y python3 amazon-cloudwatch-agent
useradd --system --shell /sbin/nologin smokeapp || true
install -d -o smokeapp -g smokeapp /opt/platform /var/log/platform
cat > /opt/platform/app.py <<'PY'
import json
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
class Handler(BaseHTTPRequestHandler):
    def do_GET(self):
        if self.path not in ("/", "/healthz"):
            self.send_error(404)
            return
        body = json.dumps({"service": "${app}", "status": "ok", "demo": True}).encode()
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
ThreadingHTTPServer(("0.0.0.0", 8080), Handler).serve_forever()
PY
cat > /etc/systemd/system/platform.service <<'UNIT'
[Unit]
Description=Platform smoke application (not a production business application)
After=network-online.target
[Service]
User=smokeapp
Group=smokeapp
ExecStart=/usr/bin/python3 /opt/platform/app.py
Restart=always
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
StandardOutput=append:/var/log/platform/app.log
StandardError=append:/var/log/platform/app.log
[Install]
WantedBy=multi-user.target
UNIT
cat > /opt/aws/amazon-cloudwatch-agent/etc/platform.json <<'JSON'
{"agent":{"region":"${region}"},"logs":{"logs_collected":{"files":{"collect_list":[{"file_path":"/var/log/platform/app.log","log_group_name":"${log_group}","log_stream_name":"{instance_id}/application"},{"file_path":"/var/log/cloud-init-output.log","log_group_name":"${log_group}","log_stream_name":"{instance_id}/bootstrap"}]}}}}
JSON
systemctl daemon-reload
systemctl enable --now platform
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl -a fetch-config -m ec2 -s -c file:/opt/aws/amazon-cloudwatch-agent/etc/platform.json
